# Data model — schema reference.
# Copy to architecture/data-model/model-[name].yaml and fill in.
# Files ending in .example are ignored by the records-query skill.

model:
  - entity: User
    table: users                      # relational storage
    collection: users                 # only when a document database is used
    fields:
      id: uuid primary key
      email: citext not null unique
      password_hash: text not null
      created_at: timestamptz not null default now()
    relations:
      has_many:
        - password_reset_tokens
      has_one:
        - profile

  - entity: PasswordResetToken
    table: password_reset_tokens
    fields:
      id: uuid primary key
      user_id: uuid not null references users(id) on delete cascade
      token_hash: text not null       # SHA-256 of the token; never store the raw value
      expires_at: timestamptz not null
      used_at: timestamptz null       # single-use marker
    relations:
      has_one:
        - user
